{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "allows the main window to use local project storage",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "dialog:allow-open",
    "dialog:allow-save",
    "sql:allow-load",
    "sql:allow-select",
    "sql:allow-execute",
    "sql:allow-close",
    "store:default"
  ]
}
