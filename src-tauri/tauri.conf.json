{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "FishTongue",
  "version": "0.7.0-phase.7.1",
  "identifier": "com.fishtongue.desktop",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "title": "FishTongue",
        "width": 1440,
        "height": 900,
        "minWidth": 1360,
        "minHeight": 860,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": true,
        "dataDirectory": "webview-phase-1",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-http-cache"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'",
      "devCsp": "default-src 'self' http://localhost:3000; connect-src ipc: http://ipc.localhost http://localhost:3000 ws://localhost:3000; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": [
      "resources/lexurgy/**/*",
      "resources/fishtongue-analysis/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
